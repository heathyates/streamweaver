#!/bin/bash
set -e

systemctl stop streamweaver-mediamtx.service || true
systemctl disable streamweaver-mediamtx.service || true

# Only try to uninstall if the file exists and is not empty
if [ -s /usr/share/streamweaver/requirements.txt ]; then
    # Only uninstall packages that were installed with pip, not system packages
    grep -v -E '^(command-not-found|dbus-python|distro-info|python-apt|systemd-python|ufw|unattended-upgrades|ubuntu-advantage-tools)' /usr/share/streamweaver/requirements.txt > /tmp/streamweaver-pip-reqs.txt
    pip3 uninstall -y -r /tmp/streamweaver-pip-reqs.txt || true
    rm -f /tmp/streamweaver-pip-reqs.txt
fi

#!/bin/bash
set -e

# Create a dedicated user if it doesn't exist
if ! id "streamweaver" &>/dev/null; then
    useradd --system --no-create-home --group nogroup streamweaver
fi

# Install Python dependencies system-wide (will skip if already installed)
if [ -f /usr/share/streamweaver/requirements.txt ]; then
    pip3 install --upgrade --ignore-installed -r /usr/share/streamweaver/requirements.txt || true
fi

# Make mediamtx executable
chmod +x /usr/share/streamweaver/src/streamweaver/thirdparty/mediamtx/mediamtx

# Reload systemd and enable/start the service
systemctl daemon-reload
systemctl enable streamweaver-mediamtx.service
systemctl start streamweaver-mediamtx.service
